{
  "name": "@vinyl/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configs (base, node, next) with TypeScript and security rules.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./node": "./node.js",
    "./next": "./next.js"
  },
  "files": [
    "base.js",
    "node.js",
    "next.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.73.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "22.20.5",
    "@vinyl/tsconfig": "*",
    "vitest": "5.1.1"
  }
}
