{
  "name": "@vinyl/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, inferred types and DTOs shared by apps/web and apps/api.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vinyl/eslint-config": "*",
    "@vinyl/tsconfig": "*",
    "@vitest/coverage-v8": "5.1.1",
    "vitest": "5.1.1"
  }
}
