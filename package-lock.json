{
  "name": "vinyl-collection",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vinyl-collection",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "tools/*"
      ],
      "devDependencies": {
        "turbo": "2.11.13"
      },
      "engines": {
        "node": ">=22.13.0",
        "npm": ">=10.9.0"
      }
    },
    "node_modules/@turbo/darwin-arm64": {
      "version": "2.11.13",
      "cpu": [
        "arm64"
      ],
      "dev": true,
      "license": "MIT",
      "optional": true,
      "os": [
        "darwin"
      ]
    },
    "node_modules/turbo": {
      "version": "2.11.13",
      "dev": true,
      "license": "MIT",
      "bin": {
        "turbo": "bin/turbo"
      },
      "optionalDependencies": {
        "@turbo/darwin-64": "2.11.13",
        "@turbo/darwin-arm64": "2.11.13",
        "@turbo/linux-64": "2.11.13",
        "@turbo/linux-arm64": "2.11.13",
        "@turbo/windows-64": "2.11.13",
        "@turbo/windows-arm64": "2.11.13"
      }
    }
  }
}
