# Copy to tools/agents/.env (git-ignored) or export these variables.

# Claude credentials. Optional: if unset, the Anthropic SDK falls back to
# ANTHROPIC_AUTH_TOKEN or the active `ant auth login` profile.
ANTHROPIC_API_KEY=

# Jira (required for real runs, not for --dry-run).
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Optional overrides
# AGENTS_REPO_PATH=/absolute/path/to/vinyl-collection   (defaults to this monorepo)
# AGENTS_EFFORT=high                                    (low | medium | high | xhigh | max)
